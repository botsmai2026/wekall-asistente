# Copie este archivo como ".env" y ponga su clave. El archivo .env no se sube al repositorio.
OPENAI_API_KEY=

# Modelo de lenguaje. Debe soportar llamadas a herramientas (tool calling).
OPENAI_MODELO=gpt-4o-mini
# Ventana de contexto de ese modelo, en tokens. El worker comprueba al arrancar que la entrada máxima cabe.
OPENAI_VENTANA_CONTEXTO=128000
# Temperatura. Escriba "ninguna" si el modelo elegido no acepta este parámetro.
OPENAI_TEMPERATURA=0.1

# Solo para modelos con razonamiento que lo exijan para usar herramientas (por ejemplo "none"). Vacío = no se envía.
OPENAI_ESFUERZO_RAZONAMIENTO=

# Modelo de embeddings. La tabla espera vectores de 1536 dimensiones: cambiar a
# un modelo de otra dimensión exige una migración de la columna.
OPENAI_MODELO_EMBEDDINGS=text-embedding-3-small
